doctype html
html(lang="en")
  head
    script.
        const pathAdmin='#{pathAdmin}'
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title}
    link(rel="stylesheet", href="/adminasset/css/style.css")
    link(rel="stylesheet", href="/adminasset/css/check-box.css")    
    <script src="https://cdn.tiny.cloud/1/5hr00uf3eftssqfxtikgqr5763xunkfp51zkvphdxgw7yhq7/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>
    script(src="/adminasset/js/tinymce.js")    
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css")
    link(href="https://unpkg.com/filepond@^4/dist/filepond.css" rel="stylesheet")
    link(
        href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css"
        rel="stylesheet"
    )
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")

    
  body 
    .header 
        .inner-logo 
            .menu 
                i.fa-solid.fa-bars
            a.logo-content(href=`/${pathAdmin}/dashboard`) 
                span 28
                span Admin
        .inner-inform 
            .inner-icon 
                img(src="/adminasset/image/bell.svg", alt="")
                span 6
            .inner-admin 
                img(src=accountLogin.avatar, alt="")
                div 
                    if(accountLogin)
                        div #{accountLogin.fullname}
                        div #{accountLogin.roleFormat}
    .body
        .sider  
            .list 
                if(accountLogin.listRights) 
                    if(accountLogin.listRights.includes("view-dashboard"))     
                        a(href=`/${pathAdmin}/dashboard`) 
                            i.fa-solid.fa-gauge-high
                            div Tổng quan
                    if(accountLogin.listRights.includes("view-category"))     
                        a(href=`/${pathAdmin}/category/manage`) 
                            i.fa-solid.fa-table-cells-large
                            div Quản lý danh mục
                    if(accountLogin.listRights.includes("view-tour"))                         
                        a(href=`/${pathAdmin}/tour/manage`) 
                            i.fa-solid.fa-table-list
                            div Quản lý tour
                    a(href=`/${pathAdmin}/order/manage`) 
                        i.fa-solid.fa-list-check
                        div Quản lý đơn hàng
                    a(href=`/${pathAdmin}/user/manage`) 
                        i.fa-regular.fa-user
                        div Quản lý người dùng
                    a(href=`/${pathAdmin}/user/connect`) 
                        i.fa-solid.fa-user-group
                        div Thông tin liên hệ
                    hr 
                    a(href=`/${pathAdmin}/setting`) 
                        i.fa-solid.fa-gear
                        div Cài đặt chung
                    a(href=`/${pathAdmin}/profile`) 
                        i.fa-regular.fa-user
                        div Thông tin cá nhân
                    a.logoutButton(href="#") 
                        i.fa-solid.fa-power-off
                        div Đăng xuất
            .overlay
        block main
    
    script(src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js")
    script(src="https://unpkg.com/filepond/dist/filepond.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.6/Sortable.js")
    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    script(src="/adminasset/js/script.js")