extends ../layout/tong-quan-layout.pug


block main
    .content
        .inner-title Thùng rác tour
            if(!accountLogin.listRights.includes("rubbish-tour"))
                .section-5 
                    .inner-action 
                        select(actionOption)
                            option(value="") -- Hành động --
                            option(value="restore") Khôi phục
                            option(value="delete") Xoá vĩnh viễn
                        div(applyButton data-api=`/${pathAdmin}/tour/rubbish/apply`) Áp dụng
                    .inner-search 
                        i.fa-solid.fa-magnifying-glass
                        input(type="text" placeholder="Tìm kiếm" search)
                    
                .table-1
                    table 
                        thead 
                            tr.check-box 
                                th.check-box
                                    .checkbox-wrapper-23(checkAll)
                                        input#check-23-1(type="checkbox")
                                        label(
                                            style="--size: 20px" 
                                            for="check-23-1"
                                            )
                                            svg(viewBox="0,0,50,50")
                                                path(d="M5 30 L 20 45 L 45 5")
                                th.name-tour 
                                    div Tên tour
                                th.anh-dai-dien
                                    div Ảnh đại diện
                                th.price
                                    div Giá
                                th.remain
                                    div Còn lại
                                th.position
                                    div Vị trí
                                th.state
                                    div Trạng thái
                                th.tao-boi
                                    div Tạo bởi
                                th.update
                                    div Xoá bởi
                                th.action
                                    div Hành động
                        tbody 
                            if(tourList.length>0)
                                each item in tourList
                                    tr 
                                        td.check-box
                                            .checkbox-wrapper-23(checkItem)
                                                input(type="checkbox" id="check-"+item._id checkItemID=item._id)
                                                label(
                                                    style="--size: 20px" 
                                                    for="check-"+item._id
                                                    )
                                                    svg(viewBox="0,0,50,50")
                                                        path(d="M5 30 L 20 45 L 45 5")
                                        td.name-tour
                                            div #{item.name}
                                        td.anh-dai-dien 
                                            img(src=item.avatar, alt="") 
                                        td.price 
                                            div NL: #{item.newAdult?item.newAdult.toLocaleString("vi-VN"):0}đ
                                            div TE:  #{item.newChild?item.newChild.toLocaleString("vi-VN"):0}đ
                                            div EB:  #{item.newBaby?item.newBaby.toLocaleString("vi-VN"):0}đ
                                        td.remain 
                                            div NL:  #{item.remainAdult}
                                            div TE:  #{item.remainChild}
                                            div EB:  #{item.remainBaby}
                                        td.position
                                            div #{item.position}
                                        td.status
                                            if item.state=="active" 
                                                .active Hoạt động
                                            else if item.state=="inactive" 
                                                .inactive Ngừng hoạt động
                                            else if item.state=="delete"
                                                .delete Đã bị xoá
                                            else 
                                                .pending Chờ duyệt
                                        td.tao-boi
                                            div #{item.createdByName}
                                            div #{item.createdAtFormat}
                                        td.update
                                            div #{item.deletedByName}
                                            div #{item.deletedAtFormat}
                                        td.action
                                            .inner-list 
                                                div.inner-icon#restore(tourID=item._id)
                                                    i.fa-solid.fa-arrow-rotate-left
                                                div.inner-icon#foreverDelete(tourID=item._id)
                                                    i.fa-solid.fa-trash-can
                            else 
                                tr 
                                    td.empty-data(colspan="10") Không có dữ liệu
            
                .section-6 
                    div Hiển thị #{pagination.skip+1} - #{pagination.skip+pagination.limit} của #{pagination.total}
                    select(pagination)
                        -for (let i=1;i<=pagination.numberPage;i++)
                            option(value=i) Trang #{i}

            else 
                div.unable-access Không có quyền truy cập dữ liệu


                        
