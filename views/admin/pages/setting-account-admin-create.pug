extends ../layout/tong-quan-layout.pug

block main
    .content
        .inner-title Tạo tài khoản quản trị
        form#admin-create.section-8 
            .inner-group 
                label(for="fullname") Họ tên
                input(type="text" id="fullname" )
            .inner-group 
                label(for="email") Email
                input(type="email" id="email")
            .inner-group 
                label(for="phone") Số điện thoại
                input(type="text" id="phone")            
            .inner-group 
                label(for="role") Nhóm quyền
                select#role(name="") 
                    for element in listRole
                        option(value=element._id) #{element.name}
            .inner-group 
                label(for="roleName") Chức vụ
                input#roleName(type="text" )
            .inner-group 
                label(for="status") Trạng thái
                select#status(name="") 
                    option(value="active") Hoạt động
                    option(value="inactive") Ngừng hoạt động
                    option(value="pending") Chờ duyệt
            .inner-group 
                label(for="password") Mật khẩu
                input(type="password" id="password")
            .inner-group.two-col
                div.avatar 
                    label(for="avatar") Ảnh đại diện
                    div.avartar-file
                        input(type="file" id="avatar" filepond)
            
            .inner-group.two-col
                div.button
                    button Tạo mới
            .inner-group.two-col
                div.return
                    a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách


                        
