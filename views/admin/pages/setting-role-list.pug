extends ../layout/tong-quan-layout.pug

block main
    .content
        .inner-title Nhóm quyền
        
        .section-5 
            .inner-action 
                select(actionOption)
                    option -- Hành động --
                    option(value="delete") Xoá
                div(applyButton data-api=`/${pathAdmin}/setting/role/list`) Áp dụng
            .inner-search 
                i.fa-solid.fa-magnifying-glass
                input(type="text" placeholder="Tìm kiếm" search)
            a.create-button(href=`/${pathAdmin}/setting/role/create`)  + Tạo mới
                
        .table-1 
            table 
                thead 
                    tr 
                        th.check-box
                            .checkbox-wrapper-23(checkAll)
                                input(type="checkbox" id="checkAll" )
                                label(
                                    style=`--size: 20px;background-color: white`
                                    for="checkAll"
                                )
                                    svg(viewBox="0,0,50,50")
                                        path(d="M5 30 L 20 45 L 45 5")
                        th.left 
                            div Tên nhóm quyền
                        th.left
                            div Mô tả ngắn
                        th.action
                            div Hành động
                tbody
                    each item in listRights 
                        tr 
                            td.check-box
                                .checkbox-wrapper-23(checkItem)
                                    input(type="checkbox" id="check-"+item._id checkItemID=item._id)
                                    label(
                                        style=`--size: 20px;background-color: white`
                                        for="check-"+item._id
                                    )
                                        svg(viewBox="0,0,50,50")
                                            path(d="M5 30 L 20 45 L 45 5")
                            td.left
                                div #{item.name}
                            td.left
                                div #{item.description}
                            td.action.left
                                .inner-list 
                                    a.inner-icon(href=`/${pathAdmin}/setting/role/edit/${item._id}`)
                                        i.fa-solid.fa-pen-to-square
                                    div.inner-icon#deleteButton(
                                        data-id=item._id 
                                        data-api=`/${pathAdmin}/setting/role/list/delete`
                                    ) 
                                        i.fa-solid.fa-trash-can
                    
        
    


                        
