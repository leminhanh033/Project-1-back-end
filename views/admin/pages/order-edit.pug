extends ../layout/tong-quan-layout.pug

block main
    .content
        if(accountLogin.listRights.includes("edit-order"))
            .inner-title Đơn hàng: #{orderDetail.code}
            form#order-edit.section-8(code=orderDetail.code)
                .inner-group 
                    label(for="fullname") Tên khách hàng
                    input(type="text" id="fullname" value=orderDetail.fullname)
                .inner-group 
                    label(for="phone") Số điện thoại
                    input(type="text" id="phone" value=orderDetail.phone)
                .inner-group.two-col 
                    div.des
                        label(for="note") Ghi chú
                        textarea#note(name="" value=orderDetail.note) 
                .inner-group 
                    label(for="paymentMethod") Phương thức thanh toán
                    select#paymentMethod(name="")
                        option(value="money" selected=orderDetail.paymentMethod=="money") Thanh toán tiền mặt 
                        option(value="momo" selected=orderDetail.paymentMethod=="momo") Momo 
                        option(value="zalopay" selected=orderDetail.paymentMethod=="zalopay") Sử dụng Zalopay
                        option(value="bank" selected=orderDetail.paymentMethod=="bank") Chuyển khoản ngân hàng
                .inner-group 
                    label(for="paymentStatus") Trạng thái thanh toán
                    select#paymentStatus(name="")
                        option(value="paid" selected=orderDetail.paymentStatus=="paid") Đã thanh toán 
                        option(value="unpaid" selected=orderDetail.paymentStatus=="unpaid") Chưa thanh toán
                .inner-group 
                    label(for="date") Ngày đặt
                    input(type="datetime-local" id="date" value=orderDetail.createdAtFormat readonly)
                .inner-group 
                    label(for="status") Trạng thái 
                    select#status(name="")
                        option(value="active" selected=orderDetail.status=="active") Hoạt động
                        option(value="inactive" selected=orderDetail.status=="inactive") Dừng hoạt động
                        option(value="pending" selected=orderDetail.status=="pending") Chờ duyệt
                .inner-group.inner-list-tour
                    .title Danh sách tour
                    each item in orderDetail.items
                        .inner-item(item=item)
                            img(src=item.avatar, alt="")
                            .inner-infor 
                                .inner-title #{item.name}
                                div Người lớn: #{item.quantityAdult} x #{item.priceAdult.toLocaleString("vi-VN")}đ
                                div Trẻ em: #{item.quantityChild} x #{item.priceChild.toLocaleString("vi-VN")}đ
                                div Em bé: #{item.quantityBaby} x #{item.priceBaby.toLocaleString("vi-VN")}đ
                                div Ngày khởi hành: #{item.departureDate}
                                div Khởi hành tại: #{item.locationFromFormat}
                    
                .inner-group.inner-banking 
                    .title Thanh toán
                    .inner-detail 
                        div#subtotal(subtotal=orderDetail.subtotal) Tổng tiền: #{orderDetail.subtotal.toLocaleString("vi-VN")}đ
                        div Giảm: #{(orderDetail.subtotal-orderDetail.total).toLocaleString("vi-VN")}đ
                        div Mã giảm: 
                        div#total(total=orderDetail.total) Thanh toán: 
                            span.hl #{orderDetail.total.toLocaleString("vi-VN")}đ
                .inner-group.two-col
                    div.button
                        button Cập nhật
                .inner-group.two-col
                    div.return
                        a(href=`/${pathAdmin}/order/manage`) Quay lại danh sách
        else 
            div.unable-access Không có quyền truy cập


                        
