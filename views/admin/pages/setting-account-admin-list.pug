extends ../layout/tong-quan-layout.pug

block main
    .content
        .inner-title Tài khoản quản trị
        .section-4 
            .inner-filter.inner-border 
                img(src="/adminasset/image/Filter-icon.svg", alt="") 
                div Bộ lọc
            .inner-item.inner-border 
                select(filter="status") 
                    option Trạng thái
            .inner-date.inner-border 
                input(type="date" filter="fromDate")
                div -
                input(type="date" filter="toDate")
            .inner-item.inner-border 
                select(filter="role")
                    option(value="") Nhóm quyền
                    each element in listRights 
                        option(value=element._id) #{element.name}
            .inner-reset
                i.fa-solid.fa-rotate-left
                div Xóa bộ lọc
        .section-5 
            .inner-action 
                select 
                    option -- Hành động --
                    option(value="active") Hoạt động
                    option(value="inactive") Ngừng hoạt động
                    option(value="pending") Chờ duyệt 
                    option(value="delete") Xoá tài khoản
                div Áp dụng
            .inner-search 
                i.fa-solid.fa-magnifying-glass
                input(type="text" placeholder="Tìm kiếm" search)
            a.create-button(href=`/${pathAdmin}/setting/account-admin/create`)  + Tạo mới
                            
        .table-1
            table 
                thead 
                    tr 
                        th.check-box
                            .checkbox-wrapper-23(checkAll)
                                input#check-23-1(type="checkbox")
                                label(
                                    style="--size: 20px" 
                                    for="check-23-1"
                                    )
                                    svg(viewBox="0,0,50,50")
                                        path(d="M5 30 L 20 45 L 45 5")
                        th.full-name 
                            div Họ tên
                        th.anh-dai-dien
                            div Ảnh đại diện
                        th.email
                            div Email
                        th.phone
                            div Số điện thoại
                        th
                            div Nhóm quyền
                        th 
                            div Chức vụ
                        th.state
                            div Trạng thái
                        th.action
                            div Hành động
                tbody 
                    each item in listAccount
                        tr 
                            td.check-box
                                .checkbox-wrapper-23(checkItem)
                                    input(
                                        type="checkbox"
                                        id="check-"+item._id 
                                        checkItemID=item._id
                                    )
                                    label(
                                        style="--size: 20px" 
                                        for="check-"+item._id 
                                        )
                                        svg(viewBox="0,0,50,50")
                                            path(d="M5 30 L 20 45 L 45 5")
                            td.text 
                                div #{item.fullname}
                            td.anh-dai-dien
                                img(src=item.avatar, alt="")
                            td.text
                                div #{item.email}
                            td.text
                                div #{item.phone}
                            td.text
                                div #{item.roleFormat}
                            td.text
                                div #{item.roleName}
                            td.state
                                if(item.status=="active")
                                    .active Hoạt động
                                else if(item.status=="inactive")
                                    .inactive Ngừng hoạt động
                                else if(item.status=="pending")
                                    .pending Chờ duyệt
                                else if(item.status=="delete")
                                    .delete Đã xoá
                            td.action
                                .inner-list 
                                    a.inner-icon(href=`/${pathAdmin}/setting/account-admin/edit/${item._id}`) 
                                        i.fa-solid.fa-pen-to-square
                                    div.inner-icon(
                                        data-id=item._id 
                                        data-api=`/${pathAdmin}/setting/account-admin/delete`
                                    )
                                        i.fa-solid.fa-trash-can
                   
        .section-6 
            div Hiển thị 1 - 9 của 78
            select 
                option Trang 1
                option Trang 2
                option Trang 3
                option Trang 4


                        
