extends ../layout/tong-quan-layout.pug
include ../mixin/categoryTree.pug

block main
    .content
        .inner-title Tạo danh mục
        if(accountLogin.listRights.includes("create-category"))
            form#tendanhmuc.section-8 
                .inner-group 
                    label(for="name") Tên danh mục
                    input(type="text" id="name" )
                .inner-group 
                    label(for="parent") Danh mục cha
                    select#parent(name="") 
                        option(value="") -- Chọn danh mục --
                        +categoryTree(listCategory)
                .inner-group 
                    label(for="position") Vị trí
                    input(type="number" id="position")
                .inner-group 
                    label(for="state") Trạng thái
                    select#state(name="")
                        option(value="active") Hoạt động
                        option(value="inactive") Ngừng hoạt động
                        option(value="pending") Chờ duyệt
                .inner-group.two-col 
                    div.avatar 
                        label(for="avatar") Ảnh đại diện
                        div.avartar-file
                            input(type="file" id="avatar" filepond accept="image/*")
                .inner-group.two-col 
                    div.des
                        label(for="des") Mô tả
                        textarea#des(name="" textarea-mce) 
                .inner-group.two-col
                    div.button
                        button Tạo mới
                .inner-group.two-col
                    div.return
                        a(href=`/${pathAdmin}/category/manage`) Quay lại danh sách  
        else 
            div.unable-access Không có quyền truy cập


                        
