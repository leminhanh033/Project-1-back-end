extends ../layout/tong-quan-layout.pug

block main     
    .content 
        .inner-title Tổng quan
        .section-1 
            .inner-item 
                img(src="/adminasset/image/section1-user.svg", alt="")
                .inner-content 
                    div Người dùng
                    div 1.200
            .inner-item 
                img(src="/adminasset/image/section1-donhang.svg", alt="")
                .inner-content 
                    div Đơn hàng
                    div #{overview.numberOrder.toLocaleString("vi-VN")}
            .inner-item 
                img(src="/adminasset/image/section1-doanhthu.svg", alt="")
                .inner-content 
                    div Doanh thu
                    div #{overview.revenueTotal.toLocaleString("vi-VN")}đ
        .section-2
            .section-2-header 
                div Biểu đồ doanh thu
                input.chartTime(type="month")
            .graph
                div.chart
                    canvas(id="myChart")
        .section-3
            .section-3-title Đơn hàng mới
            .table 
                table 
                        thead 
                            tr 
                                th Mã
                                th Thông tin khách
                                th Danh sách tour
                                th Thanh toán
                                th Trạng thái
                                th Ngày đặt
                                
                        tbody 
                            each order in orderList
                                tr 
                                    td #{order.code}
                                    td
                                        div Họ tên: #{order.fullname}
                                        div SĐT: #{order.phone}
                                        div Ghi chú: #{order.note}
                                    td
                                        .list-product
                                            each item in order.items
                                                .inner-product 
                                                    img(src=item.avatar, alt="")
                                                    .inner-content 
                                                        div Tour Hạ Long
                                                        div Người lớn: #{item.quantityAdult} x #{item.priceAdult.toLocaleString("vi-VN")}đ
                                                        div Trẻ em: #{item.quantityChild} x #{item.priceChild.toLocaleString("vi-VN")}đ
                                                        div Em bé: #{item.quantityBaby} x #{item.priceBaby.toLocaleString("vi-VN")}đ
                                            
                                    td 
                                        div Tổng tiền: #{order.subtotal.toLocaleString("vi-VN")}đ
                                        div Giảm: 0đ
                                        div Mã giảm: 
                                        div Thanh toán: #{order.total.toLocaleString("vi-VN")}đ
                                        div PTTT: #{order.paymentMethodFormat}
                                        div TTTT: #{order.paymentStatus=="paid"?"Đã thanh toán":"Chưa thanh toán"}
                                    td 
                                        if(order.status=="active")
                                            div.active Đang hoạt động
                                        if(order.status=="inactive")
                                            div.inactive Dừng hoạt động
                                        if(order.status=="pending")
                                            div.pending Chờ duyệt
                                        if(order.status=="delete")
                                            div.delete Đã xoá
                                    td.center 
                                        div #{order.createdAtTime}
                                        div #{order.createdAtDate}
                                    
                                    



