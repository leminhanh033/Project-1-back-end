extends ../layout/tong-quan-layout.pug

block main
    .content
        .inner-title #{title}
        if(accountLogin.listRights.includes("view-infor-contact"))
            .section-4 
                .inner-filter.inner-border 
                    img(src="/adminasset/image/Filter-icon.svg", alt="") 
                    div Bộ lọc
                .inner-date.inner-border 
                    input(type="date" filter="fromDate")
                    div -
                    input(type="date" filter="toDate")
                .inner-reset(filter-reset)
                    i.fa-solid.fa-rotate-left
                    div Xóa bộ lọc
            .section-5 
                .inner-action 
                    select(actionOption)
                        option(value="") -- Hành động --
                        if(accountLogin.listRights.includes("delete-infor-contact"))
                            option(value="delete") Xoá
                    div(applyButton data-api=`/${pathAdmin}/user/connect/applyPatch`) Áp dụng
                .inner-search
                    i.fa-solid.fa-magnifying-glass
                    input(type="text" placeholder="Tìm kiếm" search)

            .table-1.table-thong-tin-lh
                table 
                    thead 
                        tr 
                            th.check-box
                                .checkbox-wrapper-23(checkAll)
                                    input#check-23-1(type="checkbox")
                                    label(
                                        style="--size: 20px" 
                                        for="check-23-1"
                                        )
                                        svg(viewBox="0,0,50,50")
                                            path(d="M5 30 L 20 45 L 45 5")
                            th.email
                                div Email
                            th.date-create
                                div Ngày tạo
                            th.action
                                div Hành động
                    tbody 
                        each item in listInfor
                            tr 
                                td.check-box
                                    .checkbox-wrapper-23(checkItem)
                                        input(
                                            type="checkbox" 
                                            id="check-"+item._id
                                            checkItemID=item._id
                                        )
                                        label(
                                            style="--size: 20px" 
                                            for="check-"+item._id
                                            )
                                            svg(viewBox="0,0,50,50")
                                                path(d="M5 30 L 20 45 L 45 5")
                                td.email
                                    div #{item.email}
                                td.date-create 
                                    div #{item.createdAtFormat}
                                td.action
                                    .inner-list 
                                        if(accountLogin.listRights.includes("delete-infor-contact"))
                                            div.inner-icon#deleteButton(data-id=item.id data-api=`/${pathAdmin}/user/connect/delete`)
                                                i.fa-solid.fa-trash-can
                        
            .section-6 
                div Hiển thị #{pagination.skip+1} - #{pagination.skip+pagination.limit} của #{pagination.total}
                select
                    -for(let i=1;i<=pagination.numberPage;i++) 
                        option(value=i) Trang #{i}
        else 
            div.unable-access Không có quyền truy cập dữ liệu
                


                        
