extends ../layout/tong-quan-layout.pug
include ../mixin/checkbox.pug
include ../mixin/categoryTree.pug

block main
    .content
        .inner-title Tạo tour
            if(accountLogin.listRights.includes("create-tour"))
                form#tourcreate.section-8 
                    .inner-group 
                        label(for="tour") Tên tour *
                        input(type="text" id="tour")
                    .inner-group 
                        label(for="name") Danh mục
                        select(id="category")
                            +categoryTree(category)            
                    .inner-group 
                        label(for="position") Vị trí
                        input(type="number" id="position")
                    .inner-group 
                        label(for="state") Trạng thái
                        select#state(name="")
                            option(value="active") Hoạt động
                            option(value="inactive") Ngừng hoạt động
                            option(value="pending") Chờ duyệt
                    .inner-group.two-col 
                        div.avatar 
                            label(for="avatar-tour") Ảnh đại diện
                            div.avartar-file
                                input(type="file" id="avatar-tour" filepond accept="image/*")
                    .inner-group.two-col 
                        div.avatar 
                            label(for="images") Ảnh mô tả tour
                            div.avartar-file
                                input(
                                    type="file" 
                                    id="images" 
                                    filepond-multi-image 
                                    accept="image/*" multiple
                                )
                    .inner-group.price 
                        div Giá cũ
                        .inner-price 
                            .inner-item 
                                span Người lớn
                                input(type="number" id="oldAdult")
                            .inner-item 
                                span Trẻ em
                                input(type="number" id="oldChild")
                            .inner-item 
                                span Em bé
                                input(type="number" id="oldBaby")
                    .inner-group.price 
                        div Giá mới
                        .inner-price 
                            .inner-item 
                                span Người lớn
                                input(type="number" id="newAdult")
                            .inner-item 
                                span Trẻ em
                                input(type="number" id="newChild")
                            .inner-item 
                                span Em bé
                                input(type="number" id="newBaby")
                    .inner-group.price 
                        div Còn lại
                        .inner-price 
                            .inner-item 
                                span Người lớn
                                input(type="number" id="remainAdult")
                            .inner-item 
                                span Trẻ em
                                input(type="number" id="remainChild")
                            .inner-item 
                                span Em bé
                                input(type="number" id="remainBaby")
                    .inner-group.destination 
                        div Những địa điểm có tour 
                        .inner-destination
                            each item in provinces
                                .inner-item(id="destination")                 
                                    +checkbox(item._id, "20px")
                                    span #{item.name}                    
                    .inner-group     
                        label(for="time") Thời gian
                        input(type="text" id="time")
                    .inner-group 
                        label(for="vehicle") Phương tiện
                        input(type="text" id="vehicle")
                    .inner-group 
                        label(for="departureDate") Ngày khởi hành
                        input(type="date" id="departureDate")
                    .inner-group.two-col 
                        div.des
                            label(for="infor") Thông tin tour
                            textarea#infor(name="infor" textarea-mce) 
                    .inner-list.two-col 
                        .inner-list-title Lịch trình tour
                        .inner-list-main 
                            .inner-schedule-item#schedule
                                .inner-header 
                                    div.square.handle
                                        img(src="/adminasset/image/add.svg", alt="")
                                    div.input
                                        input.schedule-name(type="text")
                                    div.square.rubbish-remove
                                        img(src="/adminasset/image/trash.svg", alt="")
                                    div.square.button-hidden
                                        i.fa-solid.fa-angle-down
                                .body
                                    textarea.schedule-desc(textarea-mce)
                        .inner-button.add-schedule
                            button + Thêm lich trình
                    .inner-group.two-col
                        div.button
                            button Tạo mới
                    .inner-group.two-col
                        div.return
                            a(href=`/${pathAdmin}/tour/manage`) Quay lại danh sách
            
            else 
                div.unable-access Không có quyền truy cập


                        
