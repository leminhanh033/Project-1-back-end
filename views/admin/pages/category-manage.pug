extends ../layout/tong-quan-layout.pug

block main
    .content
        .inner-title Quản lý danh mục
        if(accountLogin.listRights.includes("view-category"))
            .section-4 
                .inner-filter.inner-border 
                    img(src="/adminasset/image/Filter-icon.svg", alt="") 
                    div Bộ lọc
                .inner-item.inner-border 
                    select(filter="state")
                        option(value="") Trạng thái
                        option(value="active") Hoạt động
                        option(value="inactive") Ngừng hoạt động
                        option(value="pending") Chờ duyệt
                .inner-item.inner-border 
                    select(filter="createPerson")
                        option(value="") Người tạo
                        each item in accountList 
                            option(value=item._id) #{item.fullname}
                .inner-date.inner-border 
                    input(type="date" filter="fromDate")
                    div -
                    input(type="date" filter="toDate")
                .inner-reset(filter-reset)
                    i.fa-solid.fa-rotate-left
                    div Xóa bộ lọc
            .section-5 
                .inner-action 
                    select(actionOption)
                        option(value="") -- Hành động --
                        if(accountLogin.listRights.includes("edit-category"))
                            option(value="active") Hoạt động 
                            option(value="inactive") Ngừng hoạt động 
                            option(value="pending") Chờ duyệt 
                        if(accountLogin.listRights.includes("delete-category"))
                            option(value="delete") Xoá danh mục
                    div(applyButton data-api=`/${pathAdmin}/category/applyPatch`) Áp dụng
                .inner-search() 
                    i.fa-solid.fa-magnifying-glass
                    input(type="text" placeholder="Tìm kiếm" search )
                if(accountLogin.listRights.includes("create-category"))
                    a.create-button(href=`/${pathAdmin}/category/create`)  + Tạo mới
            .table-1 
                table 
                    thead 
                        tr 
                            th.check-box
                                .checkbox-wrapper-23(checkAll)
                                    input#checkAll(type="checkbox")
                                    label(
                                        style="--size: 20px" 
                                        for="checkAll"
                                        )
                                        svg(viewBox="0,0,50,50")
                                            path(d="M5 30 L 20 45 L 45 5")
                            th.ten-danh-muc 
                                div Tên danh mục
                            th.anh-dai-dien
                                div Ảnh đại diện
                            th.position
                                div Vị trí
                            th.state
                                div Trạng thái
                            th.tao-boi
                                div Tạo bởi
                            th.update
                                div Cập nhật bởi
                            th.action
                                div Hành động
                    tbody
                        each item in categoryList 
                            tr 
                                td.check-box
                                    .checkbox-wrapper-23(checkItem)
                                        input(type="checkbox" id=`check-${item._id}` checkItemID=item._id)
                                        label(
                                            style="--size: 20px" 
                                            for=`check-${item._id}`
                                            )
                                            svg(viewBox="0,0,50,50")
                                                path(d="M5 30 L 20 45 L 45 5")
                                td.danh-muc
                                    div #{item.name}
                                td.anh-dai-dien
                                    if (item.avatar) 
                                        img(src=item.avatar, alt="") 
                                td.position
                                    div #{item.position}
                                td.status
                                    if item.state=="active" 
                                        .active Hoạt động
                                    else if item.state=="inactive" 
                                        .inactive Ngừng hoạt động
                                    else if item.state=="delete"
                                        .delete Đã bị xoá
                                    else 
                                        .pending Chờ duyệt
                                td.tao-boi
                                    div #{item.createdByName}
                                    div #{item.createdAtFormat}
                                td.update
                                    if item.updatedByName
                                        div #{item.updatedByName}
                                        div #{item.updatedAtFormat}
                                td.action
                                    .inner-list 
                                        if(accountLogin.listRights.includes("edit-category"))
                                            a.inner-icon(href=`/${pathAdmin}/category/edit/${item._id}`) 
                                                i.fa-solid.fa-pen-to-square
                                        if(accountLogin.listRights.includes("delete-category"))
                                            div#deleteButton.inner-icon(data-id=item.id data-api=`/${pathAdmin}/category/delete`)
                                                i.fa-solid.fa-trash-can
                    
            .section-6 
                div Hiển thị #{pagination.skip+1} - #{pagination.skip+pagination.limit} của #{pagination.total}
                select(pagination)
                    -for (let i=1;i<=pagination.numberPage;i++)
                        option(value=i) Trang #{i}
        else 
            div.unable-access Không có quyền truy cập
                
                


                        
