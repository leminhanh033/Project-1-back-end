.topheader
  .container
    .inner-wrap
      .item1
        i.fa-solid.fa-phone
        span #{websiteInfor.phone}
      .item2
        i.fa-solid.fa-envelope
        span #{websiteInfor.email}
      .item3
        i.fa-solid.fa-building
        span #{websiteInfor.address}
.header
  .container
    .inner-wrap-header
      .icon-menu
        img(
          alt="" 
          src="/clientasset/img/Menu.png"
          )
      a.button-logo(href="/")
        img(
          alt="" 
          src=websiteInfor.avatar,
          )
      .inner-menu
        .beside-menu
          .content
            a(href="/") Trang chủ

          each item,index in categoryTour
            if(index<2)
              .inner-item.content
                .inner-title
                  a(href=`/category/${item.slug}`) #{item.name}
                  i.fa-solid.fa-caret-down
                ul
                  each element in item.tour
                    li
                      a(href=`/tour/detail/${element.slug}`) #{element.name}  
          if categoryTour.length>2
            div.inner-item.content 
              .inner-title
                a(href="#") Xem thêm
                i.fa-solid.fa-caret-down 
              ul
                each item,index in categoryTour
                  if(index>=2)                    
                    li
                      a(href=`/category/${item.slug}`) #{item.name}

          .content
            a(href="#") Tin tức
          .content
            a(href="#") Liên hệ
        .overlay
      a.cart(href= `/cart`)
        img(
          alt="" 
          src="/clientasset/img/Icon.jpg"
          )
        div
          img(
            alt="" 
            src="/clientasset/img/tam-giac-nhon.svg"
            )
          div.order-number 0