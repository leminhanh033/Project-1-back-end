extends ../layouts/default.pug 

block main 
  .section11
    .container
      .inner-wrap
        .inner-label
          div Giỏ Hàng
          div
            a.return(href="/") Quay lại mua hàng
            i.fa-solid.fa-angle-right
        .list-product
          
        .coupon
          form#coupon-form(action="")
            input#coupon-input(type="text")
            button Dùng Mã
        .total
          div
            .total-label Tổng tiền:
            .price
              .first-price 0 
              span  đ
          div
            .total-label Giảm:
            .price 
              span - 
              .discount 0
              span đ
          div
            .total-label Thanh toán:
            .hl 
              .final-price 0
              span đ
  .section12
    .container
      .inner-wrap
        .inner-infor-custom
          .inner-title Thông Tin Khách Hàng
          form#custom-infor.inner-form
            div
              input#name(
                placeholder="Họ và tên" 
                type="text"
                )
            div
              input#phone(
                placeholder="Số điện thoại" 
                type="text"
                )
            .hl
              textarea#note(placeholder="Ghi chú")
        .inner-method
          .inner-title Chọn phương thức thanh toán
          .inner-list
            div
              input#money.payMethod(
                checked="" 
                name="method" 
                type="radio"
                value="money"
                )
              label(for="money") Thanh toán tiền mặt khi đi tour
            div
              input#momo.payMethod(
                name="method" 
                type="radio"
                value="momo"
                )
              label(for="momo") Ví MoMo
            div
              input#bank.payMethod(
                name="method" 
                type="radio"
                value="zalopay"
                )
              label(for="bank") Zalopay
            div
              input#bank.payMethod(
                name="method" 
                type="radio"
                value="bank"
                )
              label(for="bank") Chuyển khoản ngân hàng
        .inner-banking
          .inner-title.hl-title Thông tin chuyển khoản
          .inner-infor-banking
            div Ngân hàng : Vietcombank
            div Tên tài khoản: Le Van A
            div STK: 0123456789
        .button
          button(form="custom-infor") ĐẶT TOUR
