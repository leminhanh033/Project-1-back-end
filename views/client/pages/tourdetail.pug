extends ../layouts/default 
include ../partial/breadcumb.pug

block main 
  .breadcumb
    +breadcumb(tourDetail)
 
  .section10
    .container
      .inner-left
        .inner-wrap
          if(tourDetail.images&&tourDetail.images.length>0)
            .swiper-img
              .swiper.inner-thumb(thumbsslider="")
                .swiper-wrapper
                  each item in tourDetail.images
                    .swiper-slide
                      img(
                        alt="" 
                        src=item
                        )                
                .swiper-button-next
                .swiper-button-prev
              .swiper.inner-img(style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff")
                .swiper-wrapper
                  each item in tourDetail.images
                    .swiper-slide
                      img(
                        alt="" 
                        src=item
                        )
                .swiper-button-next
                .swiper-button-prev
          .inf-tour
            .inner-content
              .inner-label Thông Tin Tour
              div !{tourDetail.information}
            .read-more
              button Xem tất cả
          .list-tour
            .inner-label Lịch Trình Tour
            .inner-list-tour
              .line
              each item in tourDetail.schedule
                .inner-item-tour
                  .dot
                  .inner-item-label #{item.name}
                  .inner-content !{item.desc}
              
      .inner-right
        .inner-wrap
          .inner-label Chuyến Đi Của Bạn
          .inner-section-1
            img(
              alt="" 
              src="/clientasset/img/left-section-1.png"
              )
            .inner-content
              .inner-content-label #{tourDetail.name}
              .rate
                .star
                  i.fa-solid.fa-star
                  i.fa-solid.fa-star
                  i.fa-solid.fa-star
                  i.fa-solid.fa-star
                  i.fa-regular.fa-star
                .number 500 lượt đánh giá
          .inner-section-2
            .inner-item
              i.fa-solid.fa-ticket-simple
              div
                span Mã Tour: 
                //- span.hl #{tourDetail.code}
            .inner-item
              i.fa-solid.fa-calendar-days
              div
                span Thời Gian: 
                span.hl #{tourDetail.time}
            .inner-item
              i.fa-solid.fa-car
              div
                span Phương Tiện: 
                span.hl #{tourDetail.vehicle}
            .inner-item
              i.fa-solid.fa-calendar-days
              div
                span Ngày Khởi Hành: 
                span.hl 20/10/2024
          .inner-section-3
            div Khởi Hành Tại: 
            select(name="" id="departFrom")
              each item in tourDetail.destinationFormat
                option(value=item.id) #{item.name}
          .inner-section-4
            .inner-section-label Số Lượng Hành Khách
            .infor
              .label Người lớn:
              input(type="number" value=1 min=0 max=tourDetail.remainAdult adult)
              .price
                span.numberLabel 1 
                span  x 
                span.hl(price=tourDetail.newAdult) #{tourDetail.newAdult.toLocaleString("vi-VN")}
            .infor
              .label Trẻ em:
              input(type="number" value=0 min=0 max=tourDetail.remainChild child)
              .price
                span.numberLabel 0
                span  x 
                span.hl(price=tourDetail.newChild) #{tourDetail.newChild.toLocaleString("vi-VN")}
            .infor
              .label Em bé:
              input(type="number" value=0 min=0 max=tourDetail.remainBaby baby)
              .price
                span.numberLabel 0 
                span  x 
                span.hl(price=tourDetail.newBaby) #{tourDetail.newBaby.toLocaleString("vi-VN")}
          .total
            div Tổng cộng:
            .hl 
              div.totalPrice #{tourDetail.newAdult.toLocaleString("vi-VN")}
              div đ
          button(class="add-cart" tourID=tourDetail._id) Thêm Vào Giỏ Hàng